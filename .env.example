NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
TWILIO_AUTH_TOKEN=
# Signed-in issue intake is on by default; set to false to pause filing (for example during maintenance).
CIVICCHAI_PUBLIC_INTAKE_ENABLED=true
CIVICCHAI_EVIDENCE_UPLOADS_ENABLED=false
# Demo logins: lists the seeded demo accounts on /login (one-tap sign-in) and lets the demo
# staff accounts skip authenticator setup. On by default; real staff accounts always need MFA.
# Set to false before a pilot accepts real citizen reports.
NEXT_PUBLIC_CIVICCHAI_DEMO_MODE=true
# Optional geocoding endpoints (defaults: public OpenStreetMap Nominatim and India Post PIN lookup).
# For heavy pilot traffic, point NOMINATIM_URL at a self-hosted or commercial Nominatim instance.
NOMINATIM_URL=
PINCODE_API_URL=
# Published on /privacy and /community-guidelines. Leave blank until the authority approves them;
# the pages then say the details are still to be published instead of inventing them.
NEXT_PUBLIC_CIVICCHAI_OPERATOR_NAME=
NEXT_PUBLIC_CIVICCHAI_GRIEVANCE_OFFICER=
NEXT_PUBLIC_CIVICCHAI_GRIEVANCE_EMAIL=
# Optional dedicated key for signing locality QR codes (defaults to a key derived from the service role key).
QR_SIGNING_SECRET=
